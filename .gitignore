# Ce fichier listait auparavant une par une les 8600 fiches de data/, ce qui
# laissait passer toute fiche telechargee depuis. Resultat : "git status"
# affichait data/ en non-suivi et un "git add ." embarquait le corpus entier.
# Un dossier ignore en bloc regle les deux (aucun fichier de data/ n'a jamais
# ete suivi -- verifie avec "git ls-files data/").

__pycache__/
*.pyc

# Le corpus et tout ce que le pipeline en tire : fiches source, XML produits,
# journaux. Ces donnees viennent de l'API du portail et se retelechargent ;
# elles n'ont rien a faire dans l'historique du code.
data/

# Sorties des outils d'analyse, regenerables a la commande. Seules les
# references du harnais (tests/expected/) sont versionnees, parce qu'elles
# servent justement de point de comparaison.
audit_*.txt
fichiers_non_conformes.txt
rapport_qualite.txt
vocabs_*.txt
couverture*.txt

# Ancienne version du schema, conservee hors depot.
mappings/fresh-schema_v4.xsd
